{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd slate && pnpm install --frozen-lockfile && pnpm --filter @slate/client run build",
  "outputDirectory": "slate/apps/client/dist",
  "installCommand": "echo 'install runs inside slate/'",
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
